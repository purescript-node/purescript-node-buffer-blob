{
  "name": "purescript-node-buffer-blob",
  "private": true,
  "description": "Bindings to node-buffer's Blob type.",
  "main": "index.js",
  "devDependencies": {
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "purescript": "0.15.16",
    "purs-tidy": "0.11.1",
    "spago": "1.0.4"
  },
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('output', { recursive: true, force: true });\"",
    "lint": "oxlint --deny-warnings src test",
    "format": "oxfmt --write 'src/**/*.js' 'test/**/*.js'",
    "build": "npm run lint && spago build --pedantic-packages --strict",
    "test": "spago test --pedantic-packages --strict",
    "check": "oxfmt --check 'src/**/*.js' 'test/**/*.js' && purs-tidy check src test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/purescript-node/purescript-node-buffer-blob.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/purescript-node/purescript-node-buffer-blob/issues"
  },
  "homepage": "https://github.com/purescript-node/purescript-node-buffer-blob#readme",
  "type": "module"
}
